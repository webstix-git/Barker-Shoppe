# Cloudflare Turnstile (contact form captcha)
# Site key is public (widget). Secret key stays server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Tag Manager container ID
# Example: GTM-K47N98SJ
NEXT_PUBLIC_GTM_ID=

# Google Analytics 4 measurement ID (optional if GTM is used)
# Admin → Data streams → Web → Measurement ID (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console HTML-tag verification token
# Search Console → Settings → Ownership verification → HTML tag
# Use only the content= value, not the full meta tag
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Midwest Family Portal tracker (track.js)
NEXT_PUBLIC_MIDWEST_TRACK_SITE_ID=
NEXT_PUBLIC_MIDWEST_TRACK_ENDPOINT=
